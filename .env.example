# 复制成 .env 后填写（.env 不会被提交）。也可以直接用同名环境变量。

# Claude API Key：https://platform.claude.com/ → API Keys
# 也可以不在这里写：启动后在页面开局清单的 BRAIN 一栏粘贴，勾「记住」会自动写进 .env
ANTHROPIC_API_KEY=

# 可选：模型（默认 claude-opus-5）
# AI_MODEL=claude-opus-5

# 可选：思考力度 low / medium / high（默认 low；越高越会想，也越慢越贵）
# AI_EFFORT=low

# 可选：单次决策超时秒数（默认 45，超时的座位本回合退回经典规则）
# AI_TIMEOUT=45

# 可选：不调 API、用离线模拟大脑（等同 npm run mock）
# AI_MOCK=1

# 可选：端口 / 监听地址。默认只给本机用；改成 0.0.0.0 会让局域网里的人也能花你的额度
# PORT=8787
# HOST=127.0.0.1
